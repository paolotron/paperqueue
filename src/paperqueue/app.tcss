/* De Stijl: heavy rules, primary blocks. Colours come from the registered themes. */
Screen {
    layout: vertical;
}

#link {
    margin: 1 2 0 2;
    border: heavy $foreground;
}

/* The dither band only has something to say under the 1-bit palette; the widget
   hides itself for the others. */
#dither {
    margin: 1 2 0 2;
    height: 2;
    color: $foreground;
    background: $background;
}

#stack, #history {
    margin: 1 2;
    height: 1fr;
    border: heavy $foreground;
}

DataTable > .datatable--header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--even-row {
    background: $panel;
}

DataTable > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: bold;
}

#empty {
    margin: 1 2;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}
