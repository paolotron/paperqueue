/* De Stijl: heavy rules, primary blocks. Colours come from the registered themes. */
Screen {
    layout: vertical;
}

#link {
    margin: 1 2 0 2;
    border: heavy $foreground;
}

#stack, #history {
    margin: 1 2;
    height: 1fr;
    border: heavy $foreground;
}

DataTable > .datatable--header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--even-row {
    background: $panel;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $foreground;
    text-style: bold;
}

#empty {
    margin: 1 2;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}
