/* De Stijl: heavy rules, primary blocks. Colours come from the registered themes. */
Screen {
    layout: vertical;
}

#link {
    margin: 1 2 0 2;
    border: heavy $foreground;
}

/* The dither band only has something to say under the 1-bit palette; the widget
   hides itself for the others. */
#dither {
    margin: 1 2 0 2;
    height: 2;
    color: $foreground;
    background: $background;
}

#stack, #history {
    margin: 1 2;
    height: 1fr;
    border: heavy $foreground;
}

DataTable > .datatable--header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--even-row {
    background: $panel;
}

DataTable > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: bold;
}

#empty {
    margin: 1 2;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

EditFieldScreen {
    align: center middle;
}

#review {
    height: 1fr;
    overflow-y: auto;
}

#review-title, #review-comment, #review-usefulness, .review-hint, #review-save, ReviewPanel > Static {
    margin-left: 4;
    margin-right: 4;
    width: 1fr;
}

#review-title {
    margin-top: 1;
    text-style: bold;
}

#review-comment {
    height: 8;
    border: heavy $foreground;
}

#review-usefulness {
    margin-top: 1;
    border: tall $foreground;
    padding: 0 1;
}

.review-hint {
    color: $text-muted;
}

#review-save {
    margin-bottom: 2;
}

#review-details-title, #review-details-score, #review-details-comment, #review-details-close {
    margin-left: 4;
    margin-right: 4;
    width: 1fr;
}

#review-details-title {
    margin-top: 2;
    text-style: bold;
}

#review-details-comment {
    margin-top: 1;
    margin-bottom: 1;
}

#review-details-close {
    margin-bottom: 2;
}

#edit-title, #edit-input, EditFieldScreen > .review-hint {
    margin-left: 4;
    margin-right: 4;
    width: 1fr;
}

#edit-title {
    margin-top: 2;
    text-style: bold;
}

#edit-input {
    border: heavy $foreground;
}
