{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paperqueue",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "RESOLVE": "1" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STACK", "class_name": "PaperStack" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PaperStack"] }],
  "observability": { "enabled": true }
}
